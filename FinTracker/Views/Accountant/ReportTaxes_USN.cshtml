@model FinTracker.Models.TaxReportViewModel

<h5>🧾 УСН @Model.UsnRateOption %</h5>

@if (Model.UsnRateOption == "6")
{
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr><th>Дата</th><th>Сумма</th><th>Описание</th></tr>
        </thead>
        <tbody>
            @foreach (var inc in Model.Incomes)
            {
                <tr>
                    <td>@inc.Date.ToString("dd.MM.yyyy")</td>
                    <td>@inc.Amount.ToString("C")</td>
                    <td>@inc.Description</td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.UsnRateOption == "15")
{
    <div class="mb-3">
        <h6>Доходы</h6>
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th><input type="checkbox" onclick="toggleAll(this, 'inc')" checked /></th>
                    <th>Дата</th>
                    <th>Сумма</th>
                    <th>НДС</th>
                    <th>Описание</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inc in Model.Incomes)
                {
                    <tr>
                        <td><input type="checkbox" name="SelectedIncomeIds" value="@inc.Id" checked /></td>
                        <td>@inc.Date.ToString("dd.MM.yyyy")</td>
                        <td>@inc.Amount.ToString("C")</td>
                        <td>
                            <select name="IncomeVat_@inc.Id" class="form-select form-select-sm">
                                <option value="0">0%</option>
                                <option value="10">10%</option>
                                <option value="20" selected>20%</option>
                            </select>
                        </td>
                        <td>@inc.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div>
        <h6>Расходы</h6>
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th><input type="checkbox" onclick="toggleAll(this, 'exp')" checked /></th>
                    <th>Дата</th>
                    <th>Сумма</th>
                    <th>Описание</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exp in Model.Expenses)
                {
                    <tr>
                        <td><input type="checkbox" name="SelectedExpenseIds" value="@exp.Id" checked /></td>
                        <td>@exp.Date.ToString("dd.MM.yyyy")</td>
                        <td>@exp.Amount.ToString("C")</td>
                        <td>@exp.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
