@model FinTracker.Models.TaxReportViewModel

<h5>🧾 ОСНО</h5>

<!-- Доходы -->
<div class="mb-4">
    <h6>Доходы</h6>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th><input type="checkbox" onclick="toggleAll(this, 'inc')" checked /></th>
                <th>Дата</th>
                <th>Сумма</th>
                <th>НДС</th>
                <th>Описание</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inc in Model.Incomes)
            {
                <tr>
                    <td><input type="checkbox" name="SelectedIncomeIds" value="@inc.Id" checked /></td>
                    <td>@inc.Date.ToString("dd.MM.yyyy")</td>
                    <td>@inc.Amount.ToString("C")</td>
                    <td>
                        <select name="IncomeVat_@inc.Id" class="form-select form-select-sm">
                            <option value="0">0%</option>
                            <option value="10">10%</option>
                            <option value="20" selected>20%</option>
                        </select>
                    </td>
                    <td>@inc.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Расходы -->
<div class="mb-4">
    <h6>Расходы (кроме ЗП)</h6>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th><input type="checkbox" onclick="toggleAll(this, 'exp')" checked /></th>
                <th>Дата</th>
                <th>Сумма</th>
                <th>Описание</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exp in Model.Expenses)
            {
                <tr>
                    <td><input type="checkbox" name="SelectedExpenseIds" value="@exp.Id" checked /></td>
                    <td>@exp.Date.ToString("dd.MM.yyyy")</td>
                    <td>@exp.Amount.ToString("C")</td>
                    <td>@exp.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Имущественный налог -->
<div class="form-check mb-2">
    <input class="form-check-input" type="checkbox" id="propertyTaxCheck" name="PropertyTaxApplied" onchange="togglePropertyTax()" />
    <label class="form-check-label" for="propertyTaxCheck">Применить имущественный налог</label>
</div>
<div id="propertyTaxBlock" style="display:none;" class="row g-3 mb-4">
    <div class="col-md-6">
        <label class="form-label">Кадастровая стоимость</label>
        <input type="number" step="0.01" name="PropertyCadCost" class="form-control" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Ставка (%)</label>
        <input type="number" step="0.01" name="PropertyRate" class="form-control" value="2.2" />
    </div>
</div>
