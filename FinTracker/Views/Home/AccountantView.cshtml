@model IEnumerable<FinTracker.Models.NotificationViewModel>

<div class="container">

    <div class="row g-3">

        <div class="col-md-6">
            <div class="info-block p-3 shadow">
                <h4 class="text-primary mb-3">📌 Напоминания</h4>
                <ul class="list-group">
                    @if (Model.Any())
                    {
                        foreach (var notification in Model)
                        {
                            <li class="list-group-item">
                                @notification.Message
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted">Нет напоминаний на ближайшие дни</li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="info-block p-3 shadow">
                <h4 class="text-primary mb-3">🚀 Действия</h4>
                <div class="row">
                    <div class="col-7">
                        <ul class="list-group">
                            <li class="list-group-item">
                                <a href="/Accountant/AddTransaction">Добавить транзакцию</a>
                            </li>
                            <li class="list-group-item">
                                <a href="/Accountant/AddEmployee">Добавить сотрудника</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-5">
                        <div class="dropdown">
                            <button class="btn btn-outline-primary w-100 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                📄 Отчет
                            </button>
                            <ul class="dropdown-menu w-100">
                                <li><a class="dropdown-item" href="/Accountant/FormASalary">По зарплатам</a></li>
                                <li><a class="dropdown-item" href="/Accountant/ReportTransactions">По транзакциям</a></li>
                                <li><a class="dropdown-item" href="/Accountant/ReportTaxes">По налогам</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="info-block p-3 shadow">
                <h4>📊 График</h4>
                <canvas id="chart"></canvas>
            </div>
        </div>
    </div>

</div>